--- !u!114 &322221587
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 322221585}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 1d10be607d2ebb3488d4712095afd738, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  gamePaused: 1
  initTexts:
  - textPremade: CALIBRATING SYSTEMS... WEAPONS HOT. YOU ARE CLEARED FOR ENGAGEMENT.
    audioC: {fileID: 8300000, guid: 3f46e4b91208b9b4b8307492438f2cf1, type: 3}
  - textPremade: PILOT. YOU ARE NOW ENTERING HOSTILE SECTOR. EXPECT HEAVY RESISTANCE.
    audioC: {fileID: 8300000, guid: 6dda5a11a07848a47a015f1b2be74511, type: 3}
  - textPremade: 'NAVIGATION LOCKED. PRIMARY OBJECTIVE: ELIMINATE ALL TARGETS.'
    audioC: {fileID: 8300000, guid: 4a00d7861f3e46a4d9c4ffaad8f44648, type: 3}
  - textPremade: ANALYZING THREAT... MULTIPLE HOSTILE SIGNATURES DETECTED. COMMENCE
      ATTACK PATTERN ZULU.
    audioC: {fileID: 8300000, guid: 953be6a3fa4275d41a290232e3187b85, type: 3}
  - textPremade: SHIP SYSTEMS 100% OPERATIONAL. DEPLOYING TO COMBAT ZONE. GOOD LUCK.
    audioC: {fileID: 8300000, guid: f826fecbb4308d84ab4b303d7d972b5e, type: 3}
  shieldUpText:
  - textPremade: UPGRADE COMPLETE. SHIELD GENERATOR IS NOW OPERATING AT 100% EFFICIENCY.
    audioC: {fileID: 8300000, guid: 7797623ee9d2cff4aa4ddb1b94601f2d, type: 3}
  - textPremade: ROUTING AUXILIARY POWER TO DEFLECTORS. KINETIC BARRIER IS NOW OPERATIONAL.
    audioC: {fileID: 8300000, guid: 5c6961a9fbf01c34c9a4ef35d69269ae, type: 3}
  - textPremade: SYSTEM ONLINE. ALL NON-CRITICAL ENERGY IS BEING CONVERTED INTO A
      PROTECTIVE FIELD.
    audioC: {fileID: 8300000, guid: 6dbf495691b02be40a6be746ed64f29c, type: 3}
  shieldDownText:
  - textPremade: ALERT. SHIELD GENERATOR OFFLINE. SHIP IS VULNERABLE TO ALL ATTACKS.
    audioC: {fileID: 8300000, guid: fc85955f40b017046b478fd77bc910e8, type: 3}
  - textPremade: ENERGY SHIELD DEPLETED. HULL PLATING IS NOW EXPOSED.
    audioC: {fileID: 8300000, guid: c8c77479c5f0aff4594c5fa66f4c3c74, type: 3}
  - textPremade: ALERT. DEFLECTOR SHIELDS OFFLINE. ALL DAMAGE IS NOW CRITICAL.
    audioC: {fileID: 8300000, guid: ba4b2ac1d4703374c81200252ccad99b, type: 3}
  megaLaserActiveText:
  - textPremade: 'MEGA LASER SYSTEM: FULLY CHARGED!'
    audioC: {fileID: 8300000, guid: 6aa51e009f7e3164dbc7d3dd2526045d, type: 3}
  - textPremade: MEGA LASER COOLDOWN COMPLETE. READY TO FIRE!
    audioC: {fileID: 8300000, guid: 655e6127f67ff094c982eb7d0a9fcf73, type: 3}
  - textPremade: 'PRIMARY BEAM CANNON: 100% POWER!'
    audioC: {fileID: 8300000, guid: 495380b75f5d9a1469f3343b48cb8856, type: 3}
  - textPremade: 'MEGA LASER SYSTEM: ONLINE AND AWAITING COMMAND!'
    audioC: {fileID: 8300000, guid: 447365a2314e3d64595a68b5f586e9a3, type: 3}
  doubleWeaponActiveText: []
